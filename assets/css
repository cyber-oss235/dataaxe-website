html, body, div, span, applet, object, iframe, h1, h2, h3, h4, h5, h6, p, blockquote, pre, a, abbr, acronym, address, big, cite, code, del, dfn, em, img, ins, kbd, q, s, samp, small, strike, strong, sub, sup, tt, var, b, u, i, center, dl, dt, dd, ol, ul, li, fieldset, form, label, legend, table, caption, tbody, tfoot, thead, tr, th, td, article, aside, canvas, details, embed, figure, figcaption, footer, header, hgroup, menu, nav, output, ruby, section, summary, time, mark, audio, video {
	margin: 0;
	padding: 0;
	border: 0;
	font-size: 100%;
	font: inherit;
	vertical-align: baseline;
}

article, aside, details, figcaption, figure, footer, header, hgroup, menu, nav, section {
	display: block;
}

body {
	line-height: 1;
	background: #1a1a1a;
	color: #fff;
	font-family: 'Source Sans Pro', sans-serif;
}

ol, ul {
	list-style: none;
}

/* Basic Layout & Theme Styles */
#page-wrapper {
	display: flex;
	flex-direction: column;
	min-height: 100vh;
}

#header {
	background: #222;
	padding: 1.5em 2em;
	display: flex;
	justify-content: space-between;
	align-items: center;
	border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

#header h1 a {
	color: #fff;
	text-decoration: none;
	font-weight: 600;
	font-size: 1.25em;
}

#banner {
	background: linear-gradient(135deg, #111 0%, #1f2833 100%);
	padding: 6em 2em;
	text-align: center;
	border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

#banner .inner .logo {
	width: 4em;
	height: 4em;
	margin: 0 auto 1.5em auto;
	border: solid 2px;
	border-radius: 100%;
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: 1.5em;
}

#banner h2 {
	font-size: 2.5em;
	font-weight: 600;
	margin-bottom: 0.5em;
	letter-spacing: 2px;
}

#banner p {
	font-size: 1.2em;
	color: #aaa;
	letter-spacing: 1px;
}

.wrapper {
	padding: 4em 0;
}

.wrapper.alt {
	background: rgba(0, 0, 0, 0.15);
}

.inner {
	width: 90%;
	max-width: 1200px;
	margin: 0 auto;
}

/* Spotlights */
.wrapper.spotlight {
	background-color: #1a1a1a;
	border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.wrapper.spotlight .inner {
	display: flex;
	align-items: center;
	gap: 3em;
}

.wrapper.spotlight:nth-child(even) .inner {
	flex-direction: row-reverse;
}

.wrapper.spotlight img {
	width: 45%;
	object-fit: cover;
}

.wrapper.spotlight .content {
	width: 55%;
}

.wrapper.spotlight h2.major {
	font-size: 1.8em;
	margin-bottom: 0.8em;
	color: #00b7ff;
}

.wrapper.spotlight p {
	color: #ccc;
	line-height: 1.6;
	font-size: 1.1em;
}

/* Features Grid */
.features {
	display: flex;
	flex-wrap: wrap;
	gap: 2em;
	margin-top: 2em;
}

.features article {
	background: #222;
	padding: 2em;
	border-radius: 12px;
	width: calc(50% - 1em);
	box-sizing: border-box;
	border: 1px solid rgba(255, 255, 255, 0.05);
}

.features article img {
	margin-bottom: 1.5em;
}

.features article h3 {
	font-size: 1.2em;
	margin-bottom: 0.8em;
	color: #00d2ff;
}

.features article p {
	color: #aaa;
	font-size: 0.95em;
	line-height: 1.5;
}

/* Footer Styles */
#footer {
	background: #111;
	padding: 5em 0 3em 0;
	border-top: 1px solid rgba(255, 255, 255, 0.1);
}

#footer h2.major {
	font-size: 1.8em;
	margin-bottom: 1.5em;
	text-align: center;
	color: #fff;
}

/* Mobile Responsive */
@media screen and (max-width: 736px) {
	.wrapper.spotlight .inner {
		flex-direction: column !important;
	}
	.wrapper.spotlight img, .wrapper.spotlight .content {
		width: 100% !important;
	}
	.features article {
		width: 100% !important;
	}
}
